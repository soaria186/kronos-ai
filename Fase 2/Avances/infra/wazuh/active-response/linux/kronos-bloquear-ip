#!/usr/bin/python3
"""Kronos: bloquea o desbloquea una IP con iptables. Uso por Active Response:
extra_args = ["aplicar" | "quitar", "<ip>"] (exactamente dos argumentos).

Nunca bloquea loopback, la direccion no especificada, una IP del propio equipo ni su
puerta de enlace (dejaria al equipo sin red). Si no puede leer la puerta de enlace, no
actua."""
import datetime, ipaddress, json, subprocess, sys

LOG = "/var/ossec/logs/active-responses.log"


def log(msg):
    hora = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    with open(LOG, "a") as f:
        f.write(f"{hora} kronos-bloquear-ip: {msg}\n")


def puertas_de_enlace():
    """IP de las puertas de enlace por omision. None si no se puede leer la de IPv4.

    Un equipo sin IPv6 puede responder con error a `ip -6`: eso no impide actuar."""
    puertas = set()
    for familia in ("-4", "-6"):
        r = subprocess.run(["ip", "-j", familia, "route", "show", "default"],
                           capture_output=True, text=True)
        if r.returncode != 0:
            if familia == "-4":
                return None
            continue
        try:
            rutas = json.loads(r.stdout or "[]")
        except ValueError:
            if familia == "-4":
                return None
            continue
        for ruta in rutas:
            if isinstance(ruta, dict) and ruta.get("gateway"):
                puertas.add(str(ruta["gateway"]).split("%")[0])
    return puertas


try:
    args = json.loads(sys.stdin.readline())["parameters"]["extra_args"]
except Exception as e:
    log(f"entrada invalida: {e}")
    sys.exit(1)

if not isinstance(args, list) or len(args) != 2 or not all(isinstance(a, str) for a in args):
    cantidad = len(args) if isinstance(args, list) else "?"
    log(f"entrada invalida: se esperaban 2 argumentos y llegaron {cantidad}")
    sys.exit(1)

op = args[0]
try:
    ip = ipaddress.ip_address(args[1])
except ValueError as e:
    log(f"entrada invalida: {e}")
    sys.exit(1)

if op not in ("aplicar", "quitar"):
    log(f"operacion invalida: {op}")
    sys.exit(1)

propias = subprocess.run(["hostname", "-I"], capture_output=True, text=True).stdout.split()
if ip.is_loopback or ip.is_unspecified or str(ip) in propias:
    log(f"rechazada: {ip} es del propio equipo")
    sys.exit(1)

puertas = puertas_de_enlace()
if puertas is None:
    log(f"rechazada: no se pudo leer la puerta de enlace; no se actua sobre {ip}")
    sys.exit(1)
if str(ip) in puertas:
    log(f"rechazada: {ip} es la puerta de enlace del equipo")
    sys.exit(1)

cmd = "iptables" if ip.version == 4 else "ip6tables"
regla = ["INPUT", "-s", str(ip), "-m", "comment", "--comment", "kronos", "-j", "DROP"]
existe = subprocess.run([cmd, "-C", *regla], capture_output=True).returncode == 0

if op == "aplicar" and not existe:
    r = subprocess.run([cmd, "-I", *regla], capture_output=True, text=True)
elif op == "quitar" and existe:
    r = subprocess.run([cmd, "-D", *regla], capture_output=True, text=True)
else:
    log(f"{op} {ip}: sin cambios ({'ya estaba' if existe else 'no estaba'})")
    sys.exit(0)

log(f"{op} {ip}: {'OK' if r.returncode == 0 else 'ERROR ' + r.stderr.strip()}")
sys.exit(r.returncode)
