# Copiar a infra/docker/.env (no se versiona) y completar.
KRONOS_INQUILINOS=1

# SOAR-EXECUTE
KRONOS_WAZUH_RED=single-node_default
KRONOS_WAZUH_URL=https://wazuh.manager:55000
KRONOS_WAZUH_USUARIO=kronos-execute
# Sólo si el certificado de la API no lleva el nombre del host de la URL:
KRONOS_WAZUH_NOMBRE_SERVIDOR=

# SOAR-NOTIFY (identificadores numéricos de Telegram)
KRONOS_TELEGRAM_CHAT=-1000000000000
KRONOS_TELEGRAM_EQUIPO=111111111:nicolas,222222222:patricio,333333333:rodrigo
