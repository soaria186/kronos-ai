# Copiar a infra/docker/.env (no se versiona) y completar. Ningún valor de este archivo es real.
KRONOS_INQUILINOS=1

# SOAR-VALIDATE: un inquilino por servicio, hasta decidir cómo se asigna cada alerta.
KRONOS_INQUILINO=1
# Grupo wazuh del servidor (id wazuh); da acceso de lectura a alerts.json.
KRONOS_GID_WAZUH=999
# Volumen de logs del compose de Wazuh y red hacia Ollama.
KRONOS_WAZUH_LOGS=single-node_wazuh_logs
KRONOS_OLLAMA_RED=kronos_inferencia
KRONOS_OLLAMA_URL=http://ollama:11434
KRONOS_MODELO=qwen2.5:7b
# Plazo total, en segundos, para los dos pasos del modelo; al vencer, VALIDATE se abstiene
# (TIEMPO_EXCEDIDO). La meta es decidir en 60 s; con el modelo cargado toma unos 20 s.
KRONOS_PLAZO_SEGUNDOS=120

# SOAR-EXECUTE
KRONOS_WAZUH_RED=single-node_default
KRONOS_WAZUH_URL=https://wazuh.manager:55000
KRONOS_WAZUH_USUARIO=kronos-execute
# Nombre con que se verifica el certificado de la API, si no es el host de la URL. El
# certificado de fábrica del compose de Wazuh 4.14.8 dice CN wazuh.com y SAN localhost
# (comprobado el 20-10-2026), así que con él va localhost. Vacío si el certificado ya
# lleva el nombre del host.
KRONOS_WAZUH_NOMBRE_SERVIDOR=localhost

# SOAR-NOTIFY (identificadores numéricos de Telegram; estos son de ejemplo)
KRONOS_TELEGRAM_CHAT=-1000000000000
KRONOS_TELEGRAM_EQUIPO=111111111:nicolas,222222222:patricio,333333333:rodrigo
# Nombre de cada PyME en los avisos, «inquilino:nombre» separados por coma. Opcional:
# sin él, los avisos dicen «PyME 1».
KRONOS_NOMBRES_INQUILINOS=1:PyME de demostración

# SOAR-CONSOLE: dirección donde escucha el 443 de la consola. En el servidor, su IP de
# NetBird (netbird status); nunca 0.0.0.0. En el PC de desarrollo, 127.0.0.1.
KRONOS_CONSOLA_IP=127.0.0.1
