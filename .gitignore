# Generales: valen para todo el repositorio. Las rutas propias del proyecto
# (secretos de infra/docker y de Wazuh) están en «Fase 2/Avances/.gitignore».

# Secretos y credenciales
.env
*.pem
*.key
id_ed25519*

# Bases de datos locales
*.db

# Python y herramientas
.venv/
__pycache__/
.ruff_cache/

# Sistema operativo y editores
.DS_Store
Thumbs.db
desktop.ini
~$*
